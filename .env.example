# vLLM Intel Arc Dashboard - Environment Configuration
# Copy this file to .env and update with your values
# DO NOT commit .env to git - it contains secrets!

# ========================================
# SECURITY
# ========================================

# API Key for protecting admin operations (/api/start, /api/stop, /api/pull)
# Generate a strong random key: openssl rand -hex 32
# Leave empty to disable API key requirement (not recommended for production)
API_KEY=your-secret-api-key-here

# ========================================
# SERVER
# ========================================

# Server host (0.0.0.0 for accessible from network)
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=5000

# Enable/disable reload on code changes (for development only)
RELOAD=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ========================================
# PODMAN / CONTAINER
# ========================================

# Container name
CONTAINER_NAME=vllm-intel-arc

# vLLM Docker image
IMAGE_NAME=docker.io/intel/vllm:0.17.0-xpu

# Timeout for image pull (seconds)
IMAGE_PULL_TIMEOUT=600

# Timeout for container start (seconds)
CONTAINER_START_TIMEOUT=120

# Timeout for container stop (seconds)
CONTAINER_STOP_TIMEOUT=30

# ========================================
# vLLM / MODEL INFERENCE
# ========================================

# vLLM server host (localhost for podman on same machine)
VLLM_HOST=localhost

# vLLM server port
VLLM_PORT=8000

# GPU telemetry update interval (seconds)
GPU_TELEMETRY_INTERVAL=1.0

# Default max model length
DEFAULT_MAX_MODEL_LEN=2048

# GPU memory utilization (0.0-1.0)
GPU_MEMORY_UTILIZATION=0.70

# Data type for model (float16, float32, bfloat16)
DEFAULT_DTYPE=float16

# ========================================
# PATHS
# ========================================

# Models directory (where model folders are stored)
MODELS_DIR=~/my_models

# Logs directory
LOG_DIR=~/.vllm-dashboard/logs

# ========================================
# DEVELOPMENT (optional)
# ========================================

# SQLite database for metrics (future use)
# DB_PATH=~/.vllm-dashboard/metrics.db
