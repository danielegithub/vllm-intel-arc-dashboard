[Unit]
Description=vLLM Intel Arc B580 Podman Manager Web Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/daniele/Scrivania/vllm-intel-arc-dashboard
ExecStart=/home/daniele/Scrivania/vllm-intel-arc-dashboard/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 5000 --timeout-graceful-shutdown 2
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
